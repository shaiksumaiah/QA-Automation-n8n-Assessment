      "name": "Fetch Top GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        380
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check_status",
              "leftValue": "={{ $json.error ? 'error' : ($json.items ? 'success' : 'error') }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b606f62e-5900-410b-b6a7-4d36e679e4a5",
      "name": "Check GitHub API Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Node: Transform & Filter Top 5\n// Reshapes raw GitHub Search API response\nconst rawData = $input.first().json;\n\nif (!rawData || !rawData.items || !Array.isArray(rawData.items)) {\n  return [{\n    json: {\n      error: true,\n      message: 'Invalid GitHub API payload structure or rate limit exceeded.'\n    }\n  }];\n}\n\n// 1. Filter out archived or disabled repositories\nconst activeRepos = rawData.items.filter(repo => !repo.archived && !repo.disabled);\n\n// 2. Sort explicitly by stargazers_count descending\nactiveRepos.sort((a, b) => b.stargazers_count - a.stargazers_count);\n\n// 3. Keep exactly top 5 results\nconst top5 = activeRepos.slice(0, 5);\n\n// 4. Map & reshape fields into clean, standardized contract\nreturn top5.map((repo, index) => {\n  const forksToStarsRatio = repo.stargazers_count > 0 ? (repo.forks_count / repo.stargazers_count).toFixed(3) : '0';\n  const lastUpdatedDays = Math.floor((new Date() - new Date(repo.pushed_at)) / (1000 * 60 * 60 * 24));\n  \n  return {\n    json: {\n      rank: index + 1,\n      repo_id: repo.id,\n      name: repo.name,\n      full_name: repo.full_name,\n      owner: repo.owner?.login || 'unknown',\n      stars: repo.stargazers_count,\n      forks: repo.forks_count,\n      open_issues: repo.open_issues_count,\n      html_url: repo.html_url,\n      description: repo.description || 'No description provided.',\n      language: repo.language || 'TypeScript',\n      topics: (repo.topics || []).slice(0, 4).join(', ') || 'none',\n      forks_stars_ratio: forksToStarsRatio,\n      days_since_push: lastUpdatedDays,\n      enriched: false\n    }\n  };\n});"
      },
      "id": "cec75186-6853-46b5-a419-b98f6550aec3",
      "name": "Transform & Filter Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        280
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.full_name }}/releases/latest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-QA-Automation-Brief/1.0"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "9e765aea-fdb1-478f-9f6a-cc634def7d21",
      "name": "Enrich with Latest Release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        280
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Node: Merge & Normalize Enriched Release Metadata\n// Merges original repo item data with second API response\nconst items = $input.all();\n\nreturn items.map(item => {\n  // Access previous node data for the parent repository\n  const repoData = $('Transform & Filter Top 5').item.json;\n  const releaseData = item.json;\n\n  let latestTag = 'No formal release';\n  let releaseName = 'N/A';\n  let publishedDate = 'N/A';\n  let releaseUrl = repoData.html_url + '/releases';\n\n  // If latest release exists and is not a 404/error object\n  if (releaseData && releaseData.tag_name && !releaseData.error) {\n    latestTag = releaseData.tag_name;\n    releaseName = releaseData.name || releaseData.tag_name;\n    publishedDate = releaseData.published_at ? releaseData.published_at.substring(0, 10) : 'N/A';\n    releaseUrl = releaseData.html_url || releaseUrl;\n  }\n\n  return {\n    json: {\n      ...repoData,\n      enriched: true,\n      latest_release_tag: latestTag,\n      latest_release_name: releaseName,\n      latest_release_date: publishedDate,\n      latest_release_url: releaseUrl,\n      is_tier1_mega: repoData.stars >= 50000\n    }\n  };\n});"
      },
      "id": "f39ed33d-41ff-4fba-b41e-c7d32bfa980a",
      "name": "Merge Enriched Release Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "star_threshold",
              "leftValue": "={{ $json.stars }}",
              "rightValue": 50000,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "5a2a305b-a0d7-4ba0-a318-9a27823f8ab6",
      "name": "Evaluate Star Threshold (>= 50k)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1660,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Node: Format Tier 1 Mega-Project Digest\nconst items = $input.all();\nconst repos = items.map(i => i.json);\n\nconst repoLines = repos.map(r => {\n  return `\u2b50 **[#${r.rank}] [${r.full_name}](${r.html_url})**\n\u2022 **Stars:** ${r.stars.toLocaleString()} | **Forks:** ${r.forks.toLocaleString()} | **Issues:** ${r.open_issues}\n\u2022 **Release:** [${r.latest_release_tag}](${r.latest_release_url}) (${r.latest_release_date})\n\u2022 **Topics:** \\`${r.topics}\\`\n\u2022 *${r.description}*`;\n}).join('\\n\\n');\n\nconst message = {\n  title: '\ud83d\ude80 Daily Morning Brief: Tier-1 Mega Projects (Stars >= 50k)',\n  category: 'Tier-1 Mega Repos',\n  timestamp: new Date().toISOString(),\n  count: repos.length,\n  content: repoLines\n};\n\nreturn [{ json: message }];"
      },
      "id": "44714f60-a283-4d58-b640-f5cf805cfc41",
      "name": "Format Tier-1 Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Node: Format Emerging High-Growth Digest\nconst items = $input.all();\nconst repos = items.map(i => i.json);\n\nconst repoLines = repos.map(r => {\n  return `\u2728 **[#${r.rank}] [${r.full_name}](${r.html_url})**\n\u2022 **Stars:** ${r.stars.toLocaleString()} | **Forks:** ${r.forks.toLocaleString()}\n\u2022 **Latest Tag:** ${r.latest_release_tag}\n\u2022 *${r.description}*`;\n}).join('\\n\\n');\n\nconst message = {\n  title: '\ud83c\udf31 Daily Morning Brief: High-Growth Trending Projects (< 50k Stars)',\n  category: 'High-Growth Trending',\n  timestamp: new Date().toISOString(),\n  count: repos.length,\n  content: repoLines\n};\n\nreturn [{ json: message }];"
      },
